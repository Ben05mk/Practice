import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.model_selection import cross_val_score

def scores_table(model, subtitle):
    scores = ['accuracy', 'precision', 'recall', 'f1', 'roc_auc']
    res = []
    
    # 1. 5 폴드 교차 검증 점수 계산
    for sc in scores:
        cv_scores = cross_val_score(model, X, y, cv=5, scoring=sc)
        res.append(cv_scores)
        
    df = pd.DataFrame(res).T
    df.loc['mean'] = df.mean()
    df.loc['std'] = df.std()
    df = df.rename(columns={0: 'accuracy', 1: 'precision', 2: 'recall', 3: 'f1', 4: 'roc_auc'})

    # 2. Matplotlib 표 출력을 위한 데이터 준비
    # 폴드 번호 + mean, std (총 7개 행)
    row_labels = ['Fold 1', 'Fold 2', 'Fold 3', 'Fold 4', 'Fold 5', 'Mean', 'Std']
    
    # 표에 들어갈 셀 데이터 (소수점 3자리 반올림)
    cell_data = []
    for col in df.columns:
        cell_data.append(np.round(df[col].values, 3))
        
    # 열 이름 설정
    col_labels = ['Accuracy', 'Precision', 'Recall', 'F1 score', 'Roc auc']

    # 3. Matplotlib Figure 생성
    fig, ax = plt.subplots(figsize=(9, 4))
    ax.axis('off')  # 축 선 숨기기
    
    # 타이틀 추가
    plt.title(f'Cross Validation - 5 folds\n{subtitle}', fontsize=14, fontweight='bold', pad=20)

    # 4. 표(Table) 그리기
    table = ax.table(
        cellText=np.array(cell_data).T,
        rowLabels=row_labels,
        colLabels=col_labels,
        loc='center',
        cellLoc='center',
        rowLoc='center'
    )

    # 5. 표 스타일 꾸미기
    table.auto_set_font_size(False)
    table.set_fontsize(12)
    table.scale(1.2, 1.6)  # 표 크기 조절

    # 헤더와 평균/표준편차 행 색상 꾸미기 (시각적 포인트)
    for (row, col), cell in table.get_celld().items():
        if row == 0:  # 헤더 행
            cell.set_facecolor('#a1c3d1')
            cell.set_text_props(weight='bold', color='black')
        elif row >= 6:  # Mean, Std 행 (마지막 두 줄)
            cell.set_facecolor('#e2eff5')
            cell.set_text_props(weight='bold', color='black')
        else:  # 일반 Fold 행
            cell.set_facecolor('#EDFAFF')

    plt.tight_layout()
    plt.show()

