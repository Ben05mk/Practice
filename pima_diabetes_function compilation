#MAR(missing at random) 확인
def missing_plot(dataset,key):
  missing_dict={i:0 for i in dataset.columns}
  filtered_rows=dataset[key].isnull()
  for i in range(len(dataset.columns)-1):
    a=len(dataset[key])-(dataset[dataset.columns[i]].isnull()==filtered_rows).sum()
    missing_dict[dataset.columns[i]]=a

  
  plt.figure(figsize=(8,8))
  plt.bar(missing_dict.keys(),missing_dict.values(), width=0.1)
  plt.show()

