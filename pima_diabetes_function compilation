#feature 2개를 같은 그래프에서 산점도로 나타냄--> 겹치는 부분 찾기 쉬움
def plot_feat1_feat2(feat1, feat2) :
    D = data[(data['Outcome'] != 0)]
    H = data[(data['Outcome'] == 0)]
    fig, ax=plt.subplots(figsize=(10,8))

    ax.scatter(D[feat1],D[feat2],color='blue',edgecolor='black',label='diabetic')
    ax.scatter(H[feat1],H[feat2],color='gold',edgecolor='black',label='healthy')
    ax.legend()
    ax.set_title('relationship between {} and {}'.format(feat1,feat2))
    ax.set_xlabel('{}'.format(feat1))
    ax.set_ylabel('{}'.format(feat2))

